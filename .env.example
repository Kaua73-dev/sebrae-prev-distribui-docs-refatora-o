APP_NAME=distribui-docs

DB_HOST=localhost
DB_PORT=3307
DB_NAME=sebrae_prev_distribui_docs
DB_USER=root
DB_PASSWORD=
DB_ECHO=false

# Arquivos
FILES_DIR_PATH=

# Email
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=nao-responda@sebraeprev.com.br
MAIL_FROM_NAME=Distribui Docs

MAIL_SENDING_DISABLED=True

MAIL_REDIRECT_ALL_TO=

MAIL_MAX_ATTACHMENT_MB=20

# Auth
# Obrigatorio. Minimo de 32 bytes, senao o pyjwt avisa (RFC 7518). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Origens do frontend, separadas por virgula. "*" serve para desenvolvimento.
CORS_ORIGINS=*

# Opcional. Só para automatizar o scripts/seed_admin.py, que cria o primeiro ADMIN.
# No uso normal prefira os argumentos, para a senha nao ficar gravada em disco:
#   python -m scripts.seed_admin --name "Nome" --email a@b.com --password SENHA
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
